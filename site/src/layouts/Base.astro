---
// Khung chung mọi trang, theo bố cục app quản lý trung tâm: máy tính có thanh tab ngang ở đầu trang,
// điện thoại có thanh tab cố định ở đáy (như BottomNav). Nền xám sáng, thẻ trắng viền mảnh, màu nhấn xanh dương.
import '../styles/global.css'
import { CalendarDays, ClipboardPen, GraduationCap, House, Phone, ScrollText } from 'lucide-react'
import ContactList from '../components/ContactList.astro'
import { CENTER, HOMEWORK_APP_URL, NAV_ITEMS } from '../data/center.js'
import { PARTNER } from '../data/fees.js'

// wide: bỏ khung giữa trang để trang tự chia các dải nền tràn hết chiều ngang (trang chủ).
const { title, description, wide = false } = Astro.props
const ICONS = { home: House, classes: CalendarDays, rules: ScrollText, register: ClipboardPen, scores: GraduationCap }

// Đường dẫn trang hiện tại, dạng "/lop-hoc" (lúc build Astro trả "/lop-hoc.html", trang chủ "/index.html").
const path =
  Astro.url.pathname
    .replace(/\.html$/, '')
    .replace(/\/index$/, '')
    .replace(/\/+$/, '') || '/'
const fullTitle = title ? `${title} – ${CENTER.name}` : `${CENTER.name} – ${CENTER.slogan}`
const desc =
  description ??
  'Lớp học Vật Lí, Hóa học ScienceHub tại Bãi Cháy, Quảng Ninh: lịch học, học phí, quy định, đăng ký học và tra cứu điểm.'
const canonical = new URL(path, Astro.site).href
const ogImage = new URL('/icon-512.png', Astro.site).href
const year = new Date().getFullYear()
const footerLink = 'inline-flex min-h-10 items-center text-slate-600 hover:text-brand-700 hover:underline'
---
<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, interactive-widget=resizes-content" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#0284c7" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:site_name" content={CENTER.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
  </head>
  <body class="flex min-h-dvh flex-col font-sans antialiased">
    <a
      href="#noi-dung"
      class="sr-only rounded-lg bg-white px-4 py-2 text-sm font-medium text-brand-700 shadow focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50"
    >
      Bỏ qua menu
    </a>

    <header class="sticky top-0 z-20 border-b border-slate-200 bg-white">
      <div class="mx-auto flex h-16 max-w-5xl items-center gap-3 px-4">
        <a href="/" class="flex min-w-0 items-center gap-3">
          <img src="/icon-192.png" alt="" width="36" height="36" class="h-9 w-9 shrink-0 rounded-lg" />
          <span class="min-w-0 leading-tight">
            <span class="block truncate text-lg font-bold text-slate-800">{CENTER.name}</span>
            <span class="block truncate text-xs text-slate-500">{CENTER.slogan}</span>
          </span>
        </a>

        <nav aria-label="Điều hướng chính" class="ml-auto hidden lg:block">
          <ul class="flex items-center gap-1">
            {NAV_ITEMS.map((item) => {
              const Icon = ICONS[item.icon]
              const active = item.href === path
              return (
                <li>
                  <a
                    href={item.href}
                    aria-current={active ? 'page' : undefined}
                    class:list={[
                      'flex min-h-11 items-center gap-2 rounded-lg px-3 text-sm font-medium transition-colors',
                      active ? 'bg-brand-100 text-brand-700' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-800',
                    ]}
                  >
                    <Icon size={18} aria-hidden="true" />
                    {item.label}
                  </a>
                </li>
              )
            })}
          </ul>
        </nav>

        <a
          href={`tel:${CENTER.phone}`}
          class="ml-auto inline-flex min-h-11 shrink-0 items-center gap-2 rounded-lg border border-slate-300 bg-white px-3 text-sm font-medium text-slate-700 hover:bg-slate-50 lg:hidden"
        >
          <Phone size={16} aria-hidden="true" />
          Gọi
        </a>
      </div>
    </header>

    <main id="noi-dung" class:list={['w-full flex-1', !wide && 'mx-auto max-w-5xl px-4 py-6 sm:py-8']}>
      <slot />
    </main>

    <footer class="border-t border-slate-200 bg-white pb-[calc(4.5rem+env(safe-area-inset-bottom))] lg:pb-0">
      <div class="mx-auto grid max-w-5xl gap-8 px-4 py-8 sm:grid-cols-2">
        <div>
          <div class="flex items-center gap-3">
            <img src="/icon-192.png" alt="" width="32" height="32" class="h-8 w-8 rounded-lg" />
            <span class="font-bold text-slate-800">{CENTER.name}</span>
          </div>
          <div class="mt-4">
            <ContactList compact />
          </div>
        </div>
        <nav aria-label="Liên kết cuối trang">
          <ul class="grid grid-cols-2 gap-x-4 text-sm sm:grid-cols-1">
            {NAV_ITEMS.slice(1).map((item) => (
              <li><a href={item.href} class={footerLink}>{item.label}</a></li>
            ))}
            <li><a href={HOMEWORK_APP_URL} class={footerLink}>App làm bài tập</a></li>
            <li><a href="/bao-mat" class={footerLink}>Chính sách bảo mật</a></li>
          </ul>
        </nav>
      </div>
      <p class="border-t border-slate-100 px-4 py-4 text-center text-xs text-slate-500">
        © {year} {CENTER.name} · Cộng tác với {PARTNER.name}
      </p>
    </footer>

    <nav
      aria-label="Điều hướng chính"
      class="bottom-nav fixed inset-x-0 bottom-0 z-30 border-t border-slate-200 bg-white pb-[env(safe-area-inset-bottom)] lg:hidden"
    >
      <ul class="grid grid-cols-5">
        {NAV_ITEMS.map((item) => {
          const Icon = ICONS[item.icon]
          const active = item.href === path
          return (
            <li>
              <a
                href={item.href}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  'flex min-h-14 w-full flex-col items-center justify-center gap-1 px-1 py-2 text-xs font-medium transition-colors',
                  active ? 'bg-brand-50 text-brand-600' : 'text-slate-500 hover:text-slate-700',
                ]}
              >
                <Icon size={22} aria-hidden="true" />
                <span>{item.short}</span>
              </a>
            </li>
          )
        })}
      </ul>
    </nav>

    <script>
      // Hiện dần khi cuộn tới (.reveal) và nút liên hệ nổi (FloatingContact) của các trang.
      import '../scripts/page-effects.js'

      // Ô nhập làm bật bàn phím ảo thì ẩn thanh tab đáy (CSS body[data-typing] .bottom-nav).
      const KEYBOARD_TYPES = new Set(['text', 'search', 'email', 'password', 'tel', 'url', 'number', 'date', 'time', 'month'])
      function opensKeyboard(element) {
        if (!(element instanceof HTMLElement)) return false
        if (element.tagName === 'TEXTAREA') return true
        return element instanceof HTMLInputElement && KEYBOARD_TYPES.has(element.type)
      }
      document.addEventListener('focusin', (event) => {
        if (opensKeyboard(event.target)) document.body.dataset.typing = ''
        else delete document.body.dataset.typing
      })
      document.addEventListener('focusout', () => {
        delete document.body.dataset.typing
      })
    </script>
  </body>
</html>
