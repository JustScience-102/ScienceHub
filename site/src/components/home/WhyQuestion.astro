---
// Khung "Câu hỏi vì sao hôm nay" (dữ liệu: src/data/cau-hoi-vi-sao.js). Trang dựng sẵn mọi câu, câu đầu hiện khi
// chưa chạy JavaScript; script trang chủ (src/scripts/home.js, setupWhy) chọn ngẫu nhiên 1 câu, mở/ẩn lời giải, đổi câu.
import { Eye, EyeOff, Lightbulb, Shuffle } from 'lucide-react'
import PageSection from '../PageSection.astro'
import SectionHeader from '../SectionHeader.astro'
import { WHY_QUESTIONS } from '../../data/cau-hoi-vi-sao.js'
import { subjectStyle } from '../../lib/catalog.js'

const { tone } = Astro.props
const questions = WHY_QUESTIONS.filter((q) => q?.cauHoi && q?.loiGiai)
---
{questions.length > 0 && (
  <PageSection id="cau-hoi-vi-sao" tone={tone}>
    <div class="grid items-center gap-8 lg:grid-cols-5 lg:gap-12">
      <SectionHeader
        id="cau-hoi-vi-sao-tieu-de"
        eyebrow="Học từ câu hỏi"
        title="Con có trả lời được không?"
        subtitle="Ở ScienceHub, các em được hướng dẫn hiểu vì sao một hiện tượng xảy ra, vì sao một công thức đúng, chứ không chỉ học thuộc để làm bài."
        class="lg:col-span-2"
      >
        <p class="mt-3 text-base text-slate-600">Mỗi lần mở trang là một câu hỏi ngẫu nhiên. Phụ huynh thử đố con nhé!</p>
      </SectionHeader>

      <div
        data-why
        class="reveal relative overflow-hidden rounded-2xl border border-slate-200 bg-white p-5 shadow-md shadow-brand-900/5 sm:p-7 lg:col-span-3"
      >
        <span
          aria-hidden="true"
          class="pointer-events-none absolute -top-10 -right-2 text-[11rem] leading-none font-black text-brand-50 select-none"
        >?</span>

        <p class="relative inline-flex items-center gap-2 text-sm font-semibold text-brand-700">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-mint-100 text-mint-700">
            <Lightbulb size={18} aria-hidden="true" />
          </span>
          Câu hỏi vì sao hôm nay
        </p>

        <div data-why-list class="relative mt-4">
          {questions.map((q, index) => (
            <article data-why-item hidden={index !== 0}>
              <span class:list={['inline-block rounded-full px-2.5 py-0.5 text-sm font-semibold', subjectStyle(q.mon).tag]}>
                {q.mon}
              </span>
              <h3 class="mt-3 text-xl leading-snug font-bold text-slate-900 sm:text-2xl">{q.cauHoi}</h3>
              <div id={`loi-giai-${index + 1}`} data-why-answer hidden class="answer-in mt-4 rounded-xl border-l-4 border-mint-500 bg-mint-50 p-4">
                <p class="text-sm font-bold text-mint-800">Lời giải</p>
                <p class="mt-1 text-base leading-relaxed text-slate-700">{q.loiGiai}</p>
              </div>
            </article>
          ))}
        </div>

        <div class="relative mt-6 flex flex-wrap gap-3">
          <button
            type="button"
            data-why-toggle
            aria-expanded="false"
            aria-controls="loi-giai-1"
            class="inline-flex min-h-12 items-center justify-center gap-2 rounded-lg bg-brand-600 px-5 text-base font-semibold text-white hover:bg-brand-700 focus-visible:ring-2 focus-visible:ring-brand-300 focus-visible:ring-offset-2 focus-visible:outline-none"
          >
            <span data-when-closed class="inline-flex items-center gap-2">
              <Eye size={18} aria-hidden="true" />
              Xem lời giải
            </span>
            <span data-when-open hidden class="inline-flex items-center gap-2">
              <EyeOff size={18} aria-hidden="true" />
              Ẩn lời giải
            </span>
          </button>
          {questions.length > 1 && (
            <button
              type="button"
              data-why-next
              class="inline-flex min-h-12 items-center justify-center gap-2 rounded-lg border border-slate-300 bg-white px-5 text-base font-medium text-slate-700 hover:bg-slate-50 focus-visible:ring-2 focus-visible:ring-brand-300 focus-visible:ring-offset-2 focus-visible:outline-none"
            >
              <Shuffle size={18} aria-hidden="true" />
              Câu khác
            </button>
          )}
        </div>
      </div>
    </div>
  </PageSection>
)}
