---
// Cuối trang chủ: nút Đăng ký học và thông tin liên hệ (ContactList, nội dung ở src/data/center.js).
import { CalendarDays, ClipboardPen } from 'lucide-react'
import ContactList from '../ContactList.astro'
import SectionHeader from './SectionHeader.astro'
---
<section id="lien-he" aria-labelledby="lien-he-tieu-de" class="relative scroll-mt-16 overflow-hidden bg-brand-700">
  <svg aria-hidden="true" viewBox="0 0 200 200" class="drift pointer-events-none absolute -top-10 -left-16 w-72 text-white opacity-[0.08]">
    <g class="orbit" fill="none" stroke="currentColor" stroke-width="3">
      <ellipse cx="100" cy="100" rx="88" ry="30" />
      <ellipse cx="100" cy="100" rx="88" ry="30" transform="rotate(60 100 100)" />
      <ellipse cx="100" cy="100" rx="88" ry="30" transform="rotate(120 100 100)" />
    </g>
    <circle cx="100" cy="100" r="12" fill="currentColor" />
  </svg>

  <div class="relative mx-auto grid max-w-5xl items-center gap-8 px-4 py-12 sm:py-16 lg:grid-cols-2 lg:gap-12">
    <SectionHeader
      id="lien-he-tieu-de"
      light
      eyebrow="Đăng ký học"
      title="Cùng con bắt đầu hỏi “vì sao”"
      subtitle="Điền thông tin và chọn lịch học, thầy sẽ gọi lại cho phụ huynh để xác nhận."
    >
      <div class="mt-7 flex flex-wrap gap-3">
        <a
          href="/dang-ky"
          class="inline-flex min-h-12 items-center justify-center gap-2 rounded-lg bg-white px-6 text-base font-semibold text-brand-700 shadow-md hover:bg-brand-50"
        >
          <ClipboardPen size={18} aria-hidden="true" />
          Đăng ký học
        </a>
        <a
          href="/lop-hoc"
          class="inline-flex min-h-12 items-center justify-center gap-2 rounded-lg border border-white/60 px-5 text-base font-medium text-white hover:bg-white/10"
        >
          <CalendarDays size={18} aria-hidden="true" />
          Xem lịch học & học phí
        </a>
      </div>
    </SectionHeader>

    <div class="reveal rounded-2xl bg-white p-5 shadow-xl shadow-brand-950/20 sm:p-6">
      <h3 class="mb-4 text-lg font-semibold text-slate-800">Liên hệ</h3>
      <ContactList />
    </div>
  </div>
</section>
