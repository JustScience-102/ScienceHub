---
// "Các lớp đang mở": xem nhanh từng môn, mỗi khối một dòng (các thứ có ca học, giáo viên, nút đăng ký đúng môn + khối).
// Dữ liệu lấy từ /api/lop-hoc như trang Lớp học & học phí; script trang chủ (setupSchedulePreview) dựng thẻ từ các
// <template> bên dưới. Không tải được thì chỉ còn liên kết sang trang Lớp học. Thay 4 thẻ lặp menu của trang chủ cũ.
import { ArrowRight, CalendarDays, Wallet } from 'lucide-react'
import PageSection from '../PageSection.astro'
import SectionHeader from '../SectionHeader.astro'
import { FEE_TABLE } from '../../data/fees.js'

const { tone } = Astro.props
const fee = FEE_TABLE[0]
---
<PageSection id="lop-dang-mo" tone={tone}>
  <SectionHeader
    id="lop-dang-mo-tieu-de"
    eyebrow="Lịch học"
    title="Các lớp đang mở"
    subtitle="Lịch học cập nhật tự động. Chọn đúng khối của con để đăng ký."
    class="mb-6"
  />

  {fee && (
    <p class="reveal mb-6 inline-flex flex-wrap items-center gap-x-2 gap-y-1 rounded-xl border border-brand-200 bg-white px-4 py-3 text-base text-slate-700 shadow-sm">
      <Wallet size={18} aria-hidden="true" className="text-brand-600" />
      <span>Học phí</span>
      <b class="text-brand-700">{fee.fee}</b>
      <span class="text-slate-500">({fee.schedule}, {fee.sessions})</span>
    </p>
  )}

  <div data-schedule aria-busy="true" class="grid gap-4 md:grid-cols-2">
    {[0, 1].map(() => (
      <div data-schedule-skeleton class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm" aria-hidden="true">
        <div class="h-6 w-24 rounded-full bg-slate-100 motion-safe:animate-pulse"></div>
        <div class="mt-5 h-4 w-3/4 rounded bg-slate-100 motion-safe:animate-pulse"></div>
        <div class="mt-3 h-4 w-1/2 rounded bg-slate-100 motion-safe:animate-pulse"></div>
        <div class="mt-6 h-4 w-2/3 rounded bg-slate-100 motion-safe:animate-pulse"></div>
        <div class="mt-3 h-4 w-1/3 rounded bg-slate-100 motion-safe:animate-pulse"></div>
      </div>
    ))}
    <p class="sr-only" data-schedule-loading>Đang tải lịch học…</p>
  </div>

  <p data-schedule-empty hidden class="rounded-2xl border border-slate-200 bg-white p-5 text-base text-slate-600 shadow-sm">
    Hiện chưa có lớp nào đang mở. Phụ huynh vui lòng liên hệ thầy để được tư vấn.
  </p>

  <a
    href="/lop-hoc"
    class="reveal mt-6 inline-flex min-h-12 items-center justify-center gap-2 rounded-lg border border-slate-300 bg-white px-5 text-base font-medium text-slate-700 hover:bg-slate-50"
  >
    <CalendarDays size={18} aria-hidden="true" />
    Xem lịch chi tiết từng ca
    <ArrowRight size={16} aria-hidden="true" />
  </a>

  <template id="mau-the-mon">
    <article class="lift overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div data-bar class="h-1.5"></div>
      <div class="px-5 pt-4 pb-2">
        <h3><span data-tag class="inline-block rounded-full px-3 py-1 text-sm font-bold"></span></h3>
        <ul data-rows class="mt-2 divide-y divide-slate-100"></ul>
      </div>
    </article>
  </template>

  <template id="mau-dong-khoi">
    <li>
      <a data-link class="group flex min-h-16 items-center justify-between gap-3 py-3">
        <span class="min-w-0">
          <span data-grade class="block text-lg font-bold text-slate-900"></span>
          <span data-days class="block text-sm text-slate-600"></span>
          <span data-teacher class="block text-sm text-slate-500"></span>
        </span>
        <span class="inline-flex shrink-0 items-center gap-1 rounded-lg bg-brand-50 px-3 py-2 text-sm font-semibold text-brand-700 group-hover:bg-brand-100">
          Đăng ký
          <ArrowRight size={16} aria-hidden="true" />
        </span>
      </a>
    </li>
  </template>
</PageSection>
