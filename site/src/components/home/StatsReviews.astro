---
// Con số và nhận xét (STATS, REVIEWS ở src/data/trang-chu.js). Chỉ hiện mục đã điền dữ liệu thật; không có gì thì
// cả phần ẩn. Số đã có sẵn trong HTML; script trang chủ (setupCountUp) cho số chạy dần lên khi cuộn tới.
import { Quote } from 'lucide-react'
import PageSection from '../PageSection.astro'
import SectionHeader from '../SectionHeader.astro'
import { filledReviews, filledStats } from '../../data/trang-chu.js'

const { tone } = Astro.props
const stats = filledStats()
const reviews = filledReviews()
const statCols = { 1: 'sm:grid-cols-1', 2: 'sm:grid-cols-2', 3: 'sm:grid-cols-3' }[stats.length] ?? 'sm:grid-cols-4'
const formatNumber = (n) => n.toLocaleString('vi-VN')
---
{(stats.length > 0 || reviews.length > 0) && (
  <PageSection id="con-so" tone={tone}>
    {stats.length > 0 && (
      <>
        <SectionHeader id="con-so-tieu-de" eyebrow="Con số" title="ScienceHub qua những con số" class="mb-8" />
        <dl class:list={['grid grid-cols-2 gap-3 sm:gap-4', statCols]}>
          {stats.map((item) => (
            <div class="reveal flex flex-col-reverse rounded-2xl border border-slate-200 bg-white p-5 text-center shadow-sm">
              <dt class="mt-1 text-sm leading-snug text-slate-600 sm:text-base">{item.nhan}</dt>
              <dd class="text-3xl font-extrabold tracking-tight text-brand-700 tabular-nums sm:text-4xl">
                <span data-count-to={item.so}>{formatNumber(item.so)}</span>{item.hauTo}
              </dd>
            </div>
          ))}
        </dl>
      </>
    )}

    {reviews.length > 0 && (
      <div class:list={[stats.length > 0 && 'mt-12']}>
        <SectionHeader
          id={stats.length > 0 ? 'nhan-xet-tieu-de' : 'con-so-tieu-de'}
          eyebrow="Cảm nhận"
          title="Phụ huynh và học sinh nói về ScienceHub"
          class="mb-8"
        />
        <ul class:list={['grid gap-4', reviews.length >= 3 ? 'md:grid-cols-3' : reviews.length === 2 ? 'md:grid-cols-2' : '']}>
          {reviews.map((review) => (
            <li class="reveal lift flex flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
              <Quote size={28} aria-hidden="true" className="text-mint-500" />
              <blockquote class="mt-3 flex-1 text-base leading-relaxed text-slate-700">{review.noiDung}</blockquote>
              <p class="mt-4 border-t border-slate-100 pt-4">
                <span class="block font-semibold text-slate-900">{review.nguoiViet}</span>
                {review.vaiTro && <span class="block text-sm text-slate-500">{review.vaiTro}</span>}
              </p>
            </li>
          ))}
        </ul>
      </div>
    )}
  </PageSection>
)}
