---
// Lưu ý "lớp học không phù hợp với học sinh quá lười" (src/data/center.js, fitNote).
import { CircleAlert } from 'lucide-react'
import { CENTER } from '../data/center.js'
---
{CENTER.fitNote && (
  <div class="flex items-start gap-3 rounded-xl border border-amber-200 bg-amber-50 p-4 text-base text-amber-900">
    <CircleAlert size={20} aria-hidden="true" className="mt-0.5 shrink-0 text-amber-700" />
    <p><b>Lưu ý trước khi đăng ký:</b> {CENTER.fitNote}</p>
  </div>
)}
