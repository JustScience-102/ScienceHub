---
// Phần đầu mỗi phần lớn của trang chủ (Lớp học, Quy định, Đăng ký): như một trang mới bắt đầu khi cuộn tới.
// Cùng kiểu PageHero (nền xanh nhạt, họa tiết khoa học mờ, dòng nhỏ xanh lá) thêm ô biểu tượng; tiêu đề là h2.
// id: id của tiêu đề (phần dùng aria-labelledby trỏ vào); icon: biểu tượng lucide.
import HeroPattern from './HeroPattern.astro'

const { id, icon: Icon, eyebrow, title, subtitle } = Astro.props
---
<header class="relative overflow-hidden border-y border-brand-100 bg-linear-to-b from-brand-50 to-white">
  <HeroPattern />
  <div class="reveal relative mx-auto max-w-5xl px-4 py-8 sm:py-11">
    <div class="flex items-center gap-4">
      {Icon && (
        <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-brand-600 text-white shadow-md shadow-brand-600/25 sm:h-14 sm:w-14">
          <Icon size={26} aria-hidden="true" />
        </span>
      )}
      <div class="min-w-0">
        {eyebrow && <p class="text-sm font-semibold tracking-wide text-mint-700 uppercase">{eyebrow}</p>}
        <h2 id={id} class="mt-0.5 text-3xl leading-tight font-extrabold tracking-tight text-slate-900 sm:text-4xl">{title}</h2>
      </div>
    </div>
    {subtitle && <p class="mt-4 max-w-2xl text-base leading-relaxed text-slate-600 sm:text-lg">{subtitle}</p>}
  </div>
</header>
