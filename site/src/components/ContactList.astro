---
// Thông tin liên hệ của Lớp học ScienceHub (trang chủ, chân trang, trang Đăng ký). Nội dung ở src/data/center.js.
import { Clock, MapPin, MessageCircle, Navigation, Phone } from 'lucide-react'
import Pending from './Pending.astro'
import { CENTER } from '../data/center.js'

const { compact = false } = Astro.props
const row = 'flex items-start gap-3'
const icon = 'mt-0.5 shrink-0 text-brand-700'
---
<ul class:list={['text-sm text-slate-700', compact ? 'space-y-2' : 'space-y-3']}>
  <li class={row}>
    <Phone size={18} aria-hidden="true" className={icon} />
    <span>
      {CENTER.contactName}:{' '}
      <a href={`tel:${CENTER.phone}`} class="font-semibold text-brand-700 hover:underline">{CENTER.phoneShown}</a>{' '}
      <span class="text-slate-500">(gọi điện hoặc Zalo)</span>
    </span>
  </li>
  <li class={row}>
    <MapPin size={18} aria-hidden="true" className={icon} />
    <span>
      {CENTER.address || <Pending />}
      {compact && CENTER.mapUrl && (
        <>
          {' '}·{' '}
          <a href={CENTER.mapUrl} target="_blank" rel="noopener noreferrer" class="font-medium text-brand-700 hover:underline">
            Xem bản đồ
          </a>
        </>
      )}
    </span>
  </li>
  <li class={row}>
    <Clock size={18} aria-hidden="true" className={icon} />
    {CENTER.hours.length > 0 ? (
      <span>
        {CENTER.hours.map((line) => <span class="block">{line}</span>)}
      </span>
    ) : (
      <span><Pending /></span>
    )}
  </li>
</ul>
{!compact && (
  <div class="mt-4 flex flex-wrap gap-2">
    <a
      href={`tel:${CENTER.phone}`}
      class="inline-flex min-h-11 items-center justify-center gap-2 rounded-lg bg-brand-600 px-4 text-sm font-semibold text-white hover:bg-brand-700"
    >
      <Phone size={16} aria-hidden="true" />
      Gọi {CENTER.phoneShown}
    </a>
    <a
      href={`https://zalo.me/${CENTER.phone}`}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex min-h-11 items-center justify-center gap-2 rounded-lg border border-slate-300 bg-white px-4 text-sm font-medium text-slate-700 hover:bg-slate-50"
    >
      <MessageCircle size={16} aria-hidden="true" />
      Nhắn Zalo
    </a>
    {CENTER.mapUrl && (
      <a
        href={CENTER.mapUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-11 items-center justify-center gap-2 rounded-lg border border-slate-300 bg-white px-4 text-sm font-medium text-slate-700 hover:bg-slate-50"
      >
        <Navigation size={16} aria-hidden="true" />
        Chỉ đường
      </a>
    )}
  </div>
)}
