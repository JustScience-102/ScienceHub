---
// "ScienceHub phù hợp với ai?" bản gọn, đặt trước form ở trang Đăng ký học (thay khung lưu ý màu vàng cũ).
// Cùng nội dung với phần ở trang chủ (FIT trong src/data/trang-chu.js).
import { Check, Users, X } from 'lucide-react'
import { FIT } from '../data/trang-chu.js'
---
<section aria-labelledby="phu-hop-gon" class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5">
  <h2 id="phu-hop-gon" class="flex items-center gap-2 text-base font-bold text-slate-900 sm:text-lg">
    <span class="flex h-8 w-8 items-center justify-center rounded-full bg-brand-50 text-brand-700">
      <Users size={18} aria-hidden="true" />
    </span>
    ScienceHub phù hợp với ai?
  </h2>
  <div class="mt-3 grid gap-3 sm:grid-cols-2 sm:gap-5">
    <div class="rounded-xl bg-mint-50 p-3">
      <h3 class="text-sm font-bold text-mint-800">Phù hợp với học sinh</h3>
      <ul class="mt-2 space-y-1.5">
        {FIT.phuHop.map((text) => (
          <li class="flex items-start gap-2 text-sm text-slate-700 sm:text-base">
            <Check size={18} aria-hidden="true" className="mt-0.5 shrink-0 text-mint-700" />
            <span>{text}</span>
          </li>
        ))}
      </ul>
    </div>
    <div class="rounded-xl bg-rose-50/70 p-3">
      <h3 class="text-sm font-bold text-rose-800">Chưa phù hợp với học sinh</h3>
      <ul class="mt-2 space-y-1.5">
        {FIT.chuaPhuHop.map((text) => (
          <li class="flex items-start gap-2 text-sm text-slate-700 sm:text-base">
            <X size={18} aria-hidden="true" className="mt-0.5 shrink-0 text-rose-500" />
            <span>{text}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
