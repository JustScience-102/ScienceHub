---
// Nội dung lấy từ các quy tắc đã chạy trong app quản lý trung tâm (ARCHITECTURE.md mục 2.5, 2.7).
// Đổi quy tắc trong app trung tâm thì sửa trang này theo. Mục để trống: giáo viên gửi nội dung rồi điền.
import Base from '../layouts/Base.astro'
import PageHeading from '../components/PageHeading.astro'
import Pending from '../components/Pending.astro'

const SECTIONS = [
  {
    title: 'Học phí',
    items: [
      'Học phí tính theo buổi học và cộng lại theo tháng. Học phí mỗi buổi của từng lớp ghi ở trang Lớp học & học phí.',
      'Buổi con có mặt và buổi con vắng không xin phép đều tính học phí.',
      'Buổi con nghỉ có phép không tính học phí.',
      'Khi Trung tâm điều chỉnh học phí, các buổi con đã học vẫn giữ nguyên mức cũ.',
    ],
  },
  {
    title: 'Học bù',
    items: [
      'Con nghỉ buổi nào có thể học bù ở một lớp khác do cùng giáo viên dạy.',
      'Buổi học bù tính học phí như buổi chính; buổi nghỉ đã được học bù không tính thêm.',
      'Mỗi buổi nghỉ chỉ được học bù một lần.',
    ],
  },
  {
    title: 'Lịch học chia theo phần',
    items: [
      'Một số môn chia nội dung mỗi tuần thành các phần (phần 1, phần 2…). Mỗi phần học một buổi và mở nhiều ca để phụ huynh chọn.',
      'Con học một ca của mỗi phần, không học hai ca của cùng một phần vì hai ca đó dạy cùng một nội dung.',
    ],
  },
  { title: 'Xin nghỉ và nội quy lớp học', items: [] },
]
---
<Base title="Quy định" description="Cách tính học phí, học bù, lịch học và nội quy lớp học của Trung tâm ScienceHub.">
  <PageHeading title="Quy định" subtitle="Phụ huynh và học sinh vui lòng đọc trước khi đăng ký." />

  <div class="space-y-4">
    {SECTIONS.map((section, index) => (
      <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
        <h2 class="flex items-center gap-3 text-lg font-semibold text-slate-800">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-sky-100 text-sm font-bold text-sky-700">
            {index + 1}
          </span>
          {section.title}
        </h2>
        {section.items.length > 0 ? (
          <ul class="mt-3 list-disc space-y-2 pl-6 text-base text-slate-700 marker:text-sky-600">
            {section.items.map((item) => <li>{item}</li>)}
          </ul>
        ) : (
          <p class="mt-3 text-base"><Pending /></p>
        )}
      </section>
    ))}
  </div>
</Base>
