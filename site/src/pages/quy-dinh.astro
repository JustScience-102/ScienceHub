---
// Nội quy và xin nghỉ: theo ý người dùng (25/11/2026). Học phí: tờ quy định của Trung tâm gia sư Chìa Khóa Vàng
// (src/data/fees.js). Lịch chia theo phần: quy tắc nhóm lớp của app quản lý (ARCHITECTURE.md mục 2.7).
import Base from '../layouts/Base.astro'
import FeeInfo from '../components/FeeInfo.astro'
import PageHeading from '../components/PageHeading.astro'
import { CENTER } from '../data/center.js'

const CLASS_RULES = [
  'Lễ phép, kính trọng thầy cô; hòa nhã, tôn trọng và giúp đỡ bạn bè.',
  'Nghiêm cấm nói tục, chửi bậy; nghiêm cấm lời nói, thái độ không đúng mực với thầy cô và bạn bè.',
  'Đi học đúng giờ, hạn chế tối đa việc đi muộn.',
  'Hạn chế ăn uống trong lớp học; giữ phòng học sạch sẽ và giữ gìn cơ sở vật chất chung.',
  'Tập trung trong giờ học, hoàn thành đầy đủ bài tập được giao.',
]

const LEAVE_RULES = [
  `Khi cần nghỉ học, phụ huynh hoặc học sinh nhắn tin báo trước cho thầy qua Zalo ${CENTER.phoneShown}.`,
  'Thầy hỗ trợ lại kiến thức buổi nghỉ hoặc sắp xếp cho em đến học bù ở một ca khác.',
  'Học phí của buổi nghỉ tính theo quy định thu học phí ở mục 3.',
]

const PART_RULES = [
  'Một số môn chia nội dung mỗi tuần thành các phần (phần 1, phần 2…). Mỗi phần học một buổi và mở nhiều ca để phụ huynh chọn.',
  'Con học một ca của mỗi phần, không học hai ca của cùng một phần vì hai ca đó dạy cùng một nội dung.',
]

const heading = 'flex items-center gap-3 text-lg font-semibold text-slate-800'
const badge = 'flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-sky-100 text-sm font-bold text-sky-700'
const card = 'scroll-mt-20 rounded-xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6'
const list = 'mt-3 list-disc space-y-2 pl-6 text-base text-slate-700 marker:text-sky-600'
---
<Base
  title="Quy định"
  description="Nội quy lớp học, xin nghỉ, học bù và quy định thu học phí của Lớp học ScienceHub."
>
  <PageHeading title="Quy định" subtitle="Phụ huynh và học sinh vui lòng đọc trước khi đăng ký." />

  <div class="space-y-4">
    <section id="noi-quy" class={card}>
      <h2 class={heading}><span class={badge}>1</span>Nội quy lớp học</h2>
      <p class="mt-4 rounded-lg bg-sky-50 px-4 py-3 text-center text-lg font-semibold text-sky-800">
        Tôn sư trọng đạo · Tiên học lễ, hậu học văn
      </p>
      <ul class={list}>
        {CLASS_RULES.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section id="xin-nghi" class={card}>
      <h2 class={heading}><span class={badge}>2</span>Xin nghỉ và học bù</h2>
      <ul class={list}>
        {LEAVE_RULES.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section id="hoc-phi" class={card}>
      <h2 class={heading}><span class={badge}>3</span>Quy định thu học phí</h2>
      <div class="mt-4">
        <FeeInfo table={false} />
      </div>
      <p class="mt-3 text-sm text-slate-500">
        Mức học phí từng loại lớp xem ở trang <a href="/lop-hoc" class="font-medium text-sky-700 hover:underline">Lớp học & học phí</a>.
      </p>
    </section>

    <section id="lich-theo-phan" class={card}>
      <h2 class={heading}><span class={badge}>4</span>Lịch học chia theo phần</h2>
      <ul class={list}>
        {PART_RULES.map((item) => <li>{item}</li>)}
      </ul>
    </section>
  </div>
</Base>
