---
// Trang chủ: các dải nền tràn hết chiều ngang (Base wide), mỗi phần một component ở src/components/home/.
// Nội dung sửa được: src/data/trang-chu.js (con số, nhận xét, ảnh, phù hợp với ai), src/data/cau-hoi-vi-sao.js,
// src/data/center.js (liên hệ). Script: src/scripts/home.js.
import Base from '../layouts/Base.astro'
import CallToAction from '../components/home/CallToAction.astro'
import ClassPhotos from '../components/home/ClassPhotos.astro'
import FitForWho from '../components/home/FitForWho.astro'
import FloatingContact from '../components/FloatingContact.astro'
import Hero from '../components/home/Hero.astro'
import SchedulePreview from '../components/home/SchedulePreview.astro'
import StatsReviews from '../components/home/StatsReviews.astro'
import TechHighlights from '../components/home/TechHighlights.astro'
import WhyQuestion from '../components/home/WhyQuestion.astro'
import { homeImage } from '../components/home/images.js'
import { PHOTOS, filledReviews, filledStats } from '../data/trang-chu.js'

// Thứ tự các phần; phần nào không có dữ liệu thì bỏ, rồi xếp nền xen kẽ: giấy kẻ ô / trắng / xanh rất nhạt.
const SECTIONS = [
  { Part: WhyQuestion, show: true },
  { Part: TechHighlights, show: true },
  { Part: SchedulePreview, show: true },
  { Part: ClassPhotos, show: PHOTOS.some((photo) => homeImage(photo.file)) },
  { Part: StatsReviews, show: filledStats().length > 0 || filledReviews().length > 0 },
  { Part: FitForWho, show: true },
]
const TONES = ['grid', 'white', 'tint']
const parts = SECTIONS.filter((section) => section.show).map((section, index) => ({
  Part: section.Part,
  tone: TONES[index % TONES.length],
}))
---
<Base wide>
  <Hero />
  {parts.map(({ Part, tone }) => <Part tone={tone} />)}
  <CallToAction />
  <FloatingContact />
</Base>

<script>
  import '../scripts/home.js'
</script>
