---
// Bố cục cùng kiểu trang chủ: PageHero, các mục là thẻ có biểu tượng trên nền xanh rất nhạt.
import { ClipboardList, Eye, KeyRound, Target, UserPen } from 'lucide-react'
import Base from '../layouts/Base.astro'
import PageHero from '../components/PageHero.astro'
import PageSection from '../components/PageSection.astro'
import { CENTER } from '../data/center.js'
import { PARTNER } from '../data/fees.js'

const SECTIONS = [
  {
    title: 'ScienceHub thu những thông tin nào',
    icon: ClipboardList,
    items: [
      'Form đăng ký học: họ tên, khối lớp và trường của học sinh, môn và lịch muốn học, họ tên và số điện thoại phụ huynh, số điện thoại học sinh (nếu có), mã học sinh giới thiệu (nếu có), ghi chú của phụ huynh.',
      'Để chống gửi đơn rác, máy chủ lưu một mã được mã hóa một chiều từ địa chỉ mạng (IP) của máy gửi đơn, không lưu địa chỉ IP thật.',
      'Tra cứu điểm: mã học sinh và số điện thoại phụ huynh, chỉ dùng để kiểm tra đúng phụ huynh của học sinh.',
    ],
  },
  {
    title: 'Dùng để làm gì',
    icon: Target,
    items: [
      'Liên hệ tư vấn và xếp lớp cho học sinh.',
      'Cho phụ huynh xem điểm các bài kiểm tra của con.',
      `Khi học sinh vào học, ScienceHub chuyển họ tên học sinh, lớp học và số điện thoại phụ huynh cho ${PARTNER.name} để Trung tâm thu học phí.`,
      'ScienceHub không bán thông tin, không chia sẻ cho bên nào khác và không dùng để quảng cáo.',
    ],
  },
  {
    title: 'Ai được xem',
    icon: Eye,
    items: [
      'Chỉ thầy phụ trách ScienceHub xem được đơn đăng ký.',
      'Kết quả tra cứu điểm chỉ hiện cho người nhập đúng mã học sinh và số điện thoại phụ huynh đã đăng ký.',
    ],
  },
  {
    title: 'Ghi nhớ đăng nhập',
    icon: KeyRound,
    items: [
      'Trang Tra cứu điểm lưu một mã đăng nhập trên trình duyệt để máy nhớ phụ huynh trong 90 ngày. Bấm “Thoát” để xóa trên máy đó.',
      'Web không dùng công cụ theo dõi hay quảng cáo.',
    ],
  },
  {
    title: 'Xem, sửa hoặc xóa thông tin',
    icon: UserPen,
    items: [
      `Phụ huynh muốn xem, sửa hoặc xóa thông tin đã gửi, vui lòng liên hệ ${CENTER.contactName}: ${CENTER.phoneShown}.`,
    ],
  },
]
---
<Base wide title="Chính sách bảo mật" description="Lớp học ScienceHub thu thập và sử dụng thông tin của phụ huynh, học sinh như thế nào.">
  <PageHero
    eyebrow="Thông tin của phụ huynh, học sinh"
    title="Chính sách bảo mật"
    subtitle="ScienceHub thu thập và sử dụng thông tin của phụ huynh, học sinh như thế nào."
  />

  <PageSection id="noi-dung-bao-mat" tone="tint" compact>
    <h2 id="noi-dung-bao-mat-tieu-de" class="sr-only">Nội dung chính sách</h2>
    <div class="grid gap-4 md:grid-cols-2">
      {SECTIONS.map((section) => {
        const Icon = section.icon
        return (
          <section class="reveal rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
            <h3 class="flex items-center gap-3 text-lg font-bold text-slate-900">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-brand-600 text-white">
                <Icon size={20} aria-hidden="true" />
              </span>
              {section.title}
            </h3>
            <ul class="mt-4 space-y-2.5">
              {section.items.map((item) => (
                <li class="flex items-start gap-3 text-base text-slate-700">
                  <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-brand-500" aria-hidden="true"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </section>
        )
      })}
    </div>
  </PageSection>
</Base>
