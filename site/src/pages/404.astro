---
import { House } from 'lucide-react'
import Base from '../layouts/Base.astro'
import PageHero from '../components/PageHero.astro'
---
<Base wide title="Không tìm thấy trang">
  <PageHero
    eyebrow="Lỗi 404"
    title="Không tìm thấy trang"
    subtitle="Địa chỉ này không có trên web của ScienceHub. Phụ huynh vui lòng quay về trang chủ."
  >
    <a
      href="/"
      class="mt-6 inline-flex min-h-12 items-center justify-center gap-2 rounded-lg bg-brand-600 px-5 text-base font-semibold text-white shadow-md shadow-brand-600/25 hover:bg-brand-700"
    >
      <House size={18} aria-hidden="true" />
      Về trang chủ
    </a>
  </PageHero>
</Base>
