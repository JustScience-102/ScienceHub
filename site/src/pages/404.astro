---
import Base from '../layouts/Base.astro'
---
<Base title="Không tìm thấy trang">
  <section class="rounded-xl border border-slate-200 bg-white p-8 text-center shadow-sm">
    <h1 class="text-2xl font-bold text-slate-800">Không tìm thấy trang</h1>
    <p class="mt-2 text-base text-slate-600">Địa chỉ này không có trên web của Trung tâm. Phụ huynh vui lòng quay về trang chủ.</p>
    <a
      href="/"
      class="mt-6 inline-flex min-h-11 items-center justify-center rounded-lg bg-sky-600 px-5 text-sm font-semibold text-white hover:bg-sky-700"
    >
      Về trang chủ
    </a>
  </section>
</Base>
