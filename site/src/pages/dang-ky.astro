---
// Mốc M3 sẽ thay phần này bằng form đăng ký (chọn lịch theo nhóm lớp: mỗi phần một ca).
import { Info } from 'lucide-react'
import Base from '../layouts/Base.astro'
import ContactList from '../components/ContactList.astro'
import PageHeading from '../components/PageHeading.astro'
---
<Base title="Đăng ký học" description="Đăng ký học tại Trung tâm ScienceHub.">
  <PageHeading title="Đăng ký học" subtitle="Điền thông tin và chọn lịch học, Trung tâm sẽ gọi lại cho phụ huynh." />

  <div class="flex items-start gap-3 rounded-xl border border-sky-200 bg-sky-50 p-4 text-sm text-sky-800">
    <Info size={18} aria-hidden="true" className="mt-0.5 shrink-0" />
    <p>
      Form đăng ký trực tuyến đang được hoàn thiện. Trong lúc chờ, phụ huynh vui lòng gọi điện hoặc nhắn Zalo cho
      Trung tâm để đăng ký.
    </p>
  </div>

  <section class="mt-6 rounded-xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
    <h2 class="mb-4 text-lg font-semibold text-slate-800">Liên hệ đăng ký</h2>
    <ContactList />
  </section>
</Base>
