---
// Form đăng ký học (mốc M3): src/components/RegistrationForm.jsx, gửi tới /api/dang-ky. Trang chỉ bọc giao diện
// (PageHero, nền giấy kẻ ô, khung "phù hợp với ai?" bản gọn, thẻ tư vấn); form giữ nguyên.
import { MessageCircleQuestion } from 'lucide-react'
import Base from '../layouts/Base.astro'
import ContactList from '../components/ContactList.astro'
import FitCompact from '../components/FitCompact.astro'
import PageHero from '../components/PageHero.astro'
import PageSection from '../components/PageSection.astro'
import RegistrationForm from '../components/RegistrationForm.jsx'
import { CENTER, CLASS_SUBJECTS } from '../data/center.js'
---
<Base wide title="Đăng ký học" description="Đăng ký học Vật Lí, Hóa học tại Lớp học ScienceHub: chọn lịch học và để lại thông tin liên hệ.">
  <PageHero
    eyebrow="Đăng ký trực tuyến"
    title="Đăng ký học"
    subtitle="Điền thông tin và chọn lịch học, thầy sẽ gọi lại cho phụ huynh để xác nhận."
  />

  <div class="tone-grid">
    <div class="mx-auto max-w-5xl px-4 py-6 sm:py-8">
      <FitCompact />
      <div class="mt-4">
        <RegistrationForm client:load subjects={CLASS_SUBJECTS} phone={CENTER.phone} phoneShown={CENTER.phoneShown} />
      </div>
    </div>
  </div>

  <PageSection id="tu-van" tone="tint" compact>
    <div class="reveal rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
      <h2 id="tu-van-tieu-de" class="mb-4 flex items-center gap-3 text-lg font-bold text-slate-900">
        <span class="flex h-9 w-9 items-center justify-center rounded-full bg-mint-100 text-mint-700">
          <MessageCircleQuestion size={20} aria-hidden="true" />
        </span>
        Cần tư vấn trước khi đăng ký?
      </h2>
      <ContactList />
    </div>
  </PageSection>
</Base>
