---
// Form đăng ký học (mốc M3): src/components/RegistrationForm.jsx, gửi tới /api/dang-ky.
import Base from '../layouts/Base.astro'
import ContactList from '../components/ContactList.astro'
import FitNote from '../components/FitNote.astro'
import PageHeading from '../components/PageHeading.astro'
import RegistrationForm from '../components/RegistrationForm.jsx'
import { CENTER, CLASS_SUBJECTS } from '../data/center.js'
---
<Base title="Đăng ký học" description="Đăng ký học Vật Lí, Hóa học tại Lớp học ScienceHub: chọn lịch học và để lại thông tin liên hệ.">
  <PageHeading title="Đăng ký học" subtitle="Điền thông tin và chọn lịch học, thầy sẽ gọi lại cho phụ huynh để xác nhận." />

  <FitNote />

  <div class="mt-4">
    <RegistrationForm client:load subjects={CLASS_SUBJECTS} phone={CENTER.phone} phoneShown={CENTER.phoneShown} />
  </div>

  <section class="mt-6 rounded-xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
    <h2 class="mb-4 text-lg font-semibold text-slate-800">Cần tư vấn trước khi đăng ký?</h2>
    <ContactList />
  </section>
</Base>
