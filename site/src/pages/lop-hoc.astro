---
// Học phí (đặt trước, phụ huynh quan tâm trước): theo quy định của Trung tâm gia sư Chìa Khóa Vàng (src/data/fees.js).
// Lịch học: lấy tự động từ app quản lý qua /api/lop-hoc (mốc M2, site/api/lop-hoc.js).
import Base from '../layouts/Base.astro'
import ClassSchedule from '../components/ClassSchedule.jsx'
import FeeInfo from '../components/FeeInfo.astro'
import PageHeading from '../components/PageHeading.astro'
import { CENTER, CLASS_SUBJECTS } from '../data/center.js'
---
<Base
  title="Lớp học & học phí"
  description="Mức học phí và lịch học các lớp Vật Lí, Hóa học đang mở của ScienceHub."
>
  <PageHeading title="Lớp học & học phí" subtitle="Mức học phí, các lớp đang mở, giáo viên và lịch học trong tuần." />

  <section>
    <h2 class="mb-3 text-lg font-semibold text-slate-800">Học phí</h2>
    <FeeInfo rules={false} />
    <p class="mt-3 text-sm text-slate-500">
      Quy định khi học sinh nghỉ học xem ở trang <a href="/quy-dinh#hoc-phi" class="font-medium text-brand-700 hover:underline">Quy định</a>.
    </p>
  </section>

  <section class="mt-8">
    <h2 class="mb-3 text-lg font-semibold text-slate-800">Lịch học các lớp</h2>
    <ClassSchedule client:load subjects={CLASS_SUBJECTS} phone={CENTER.phone} phoneShown={CENTER.phoneShown} />
  </section>
</Base>
