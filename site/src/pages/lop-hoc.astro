---
// Học phí (đặt trước, phụ huynh quan tâm trước): theo quy định của Trung tâm gia sư Chìa Khóa Vàng (src/data/fees.js).
// Lịch học: lấy tự động từ app quản lý qua /api/lop-hoc (mốc M2, site/api/lop-hoc.js).
// Bố cục cùng kiểu trang chủ: phần đầu PageHero + mục lục nhanh, các dải nền xen kẽ, nút liên hệ nổi trên điện thoại.
import { CalendarDays, ClipboardPen, Wallet } from 'lucide-react'
import Base from '../layouts/Base.astro'
import ClassSchedule from '../components/ClassSchedule.jsx'
import FeeInfo from '../components/FeeInfo.astro'
import FloatingContact from '../components/FloatingContact.astro'
import JumpLinks from '../components/JumpLinks.astro'
import PageHero from '../components/PageHero.astro'
import PageSection from '../components/PageSection.astro'
import { CENTER, CLASS_SUBJECTS } from '../data/center.js'

const JUMPS = [
  { href: '#hoc-phi', label: 'Học phí', icon: Wallet },
  { href: '#lich-hoc', label: 'Lịch học các lớp', icon: CalendarDays },
  { href: '/dang-ky', label: 'Đăng ký học', icon: ClipboardPen },
]
---
<Base
  wide
  title="Lớp học & học phí"
  description="Mức học phí và lịch học các lớp Vật Lí, Hóa học đang mở của ScienceHub."
>
  <PageHero
    eyebrow="Vật Lí · Hóa học · lớp 10–12"
    title="Lớp học & học phí"
    subtitle="Mức học phí, các lớp đang mở, giáo viên và lịch học trong tuần."
  >
    <JumpLinks items={JUMPS} />
  </PageHero>

  <PageSection id="hoc-phi" tone="white" compact eyebrow="Học phí" title="Học phí theo tháng">
    <FeeInfo rules={false} />
    <p class="mt-4 text-sm text-slate-500">
      Quy định khi học sinh nghỉ học xem ở trang <a href="/quy-dinh#hoc-phi" class="font-medium text-brand-700 hover:underline">Quy định</a>.
    </p>
  </PageSection>

  <PageSection
    id="lich-hoc"
    tone="tint"
    compact
    eyebrow="Lịch học"
    title="Lịch học các lớp"
    subtitle="Lịch cập nhật tự động. Chọn môn và khối để xem nhanh, bấm “Đăng ký lịch này” để đăng ký đúng khối."
  >
    <ClassSchedule client:load subjects={CLASS_SUBJECTS} phone={CENTER.phone} phoneShown={CENTER.phoneShown} />
  </PageSection>

  <FloatingContact />
</Base>
